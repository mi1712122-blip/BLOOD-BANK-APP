rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId)
        && request.resource.data.role in ['donor', 'organization', 'hospital'];
      allow update: if isSignedIn() && isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isSignedIn() && isOwner(userId);
    }

    match /donors/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(orgId);
      allow update: if isSignedIn() && isOwner(orgId);
      allow delete: if isSignedIn() && isOwner(orgId);
    }

    match /hospitals/{hospitalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(hospitalId);
      allow update: if isSignedIn() && isOwner(hospitalId);
      allow delete: if isSignedIn() && isOwner(hospitalId);
    }

    match /bloodRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /bloodInventory/{inventoryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.recipientId is string
        && (
          request.resource.data.recipientId == request.auth.uid
          || request.resource.data.senderId == request.auth.uid
          || isAdmin()
        );
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.isRead is bool;
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    match /contactMessages/{messageId} {
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'name', 'email', 'subject', 'message', 'senderId', 'status', 'source', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'landing-page'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
